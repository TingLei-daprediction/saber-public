# Template for the l_loc_filter_once equivalence tests (V2); configured by
# testlist/saber_mgbf.cmake into testinput/@FO_NAME@.yaml.
# Ten-member ensemble localized by MGBF. The B*Dirac output file is compared
# value by value with the matching switch-off run by
# tools/saber_compare_mgbf_filter_once.py, so no reference file is needed.
geometry: &geom
  function space: StructuredColumns
  grid:
    type: regional
    nx: 35
    ny: 25
    west: 100.0
    east: 170.0
    south: 10.0
    north: 60.0
    y_numbering: 1
  partitioner: checkerboard
  groups:
  - variables:
    - air_horizontal_streamfunction
    - air_horizontal_velocity_potential
    levels: 65
  - variables:
    - air_pressure_at_surface
    levels: 1

background:
  date: &date 2010-01-01T12:00:00Z
  state variables: &vars
  - air_horizontal_streamfunction
  - air_horizontal_velocity_potential
  - air_pressure_at_surface

background error:
  covariance model: SABER
  covariance type: ensemble
  adjoint test: @FO_ADJOINT_TEST@
  square-root test: false
  ensemble pert:
    members from template:
      template:
        date: *date
        filepath: testdata/randomization_mgbf_ensemble/member_pert_%MEM%
        state variables: *vars
      pattern: '%MEM%'
      nmembers: 10
  localization:
    saber central block:
      saber block name: MGBF_covariance
      @FO_NML_KEY@: @FO_NML_FILE@
      mgbf timer output file: testdata/@FO_NAME@/mg_timers
    saber outer blocks:
    - saber block name: interpolation
      inner geometry:
        function space: StructuredColumns
        grid:
          type: regional
          nx: 48
          ny: 48
          dx: 200.0e3
          dy: 150.0e3
          lonlat(centre):
          - 135
          - 35
          projection:
            type: lambert_conformal_conic
            latitude0: 40
            longitude0: 135
            units: degrees
          y_numbering: 1
        partitioner: checkerboard
        halo: 1
      forward interpolator:
        local interpolator type: oops unstructured grid interpolator
      inverse interpolator:
        local interpolator type: oops unstructured grid interpolator
      state variables to inverse: *vars

# Either all three Diracs (every variable slot and the cross-variable sums) or a
# single one (isolated-variable / surface-only input; also the contributions
# for the comparison bound).
dirac:
  lon: @FO_DIRAC_LON@
  lat: @FO_DIRAC_LAT@
  level: @FO_DIRAC_LEVEL@
  variable: @FO_DIRAC_VARIABLE@

# No _MPI_-_OMP_ prefix: switch-off, switch-on and OMP variants pair by file name.
output dirac:
  filepath: testdata/@FO_NAME@/dirac_%id%
